    "gradient_clip": 1.0,
    "seed": 42,
    "device": "auto",
    "output_dir": "runs",
    "experiment_name": "final-joint-mlm260",
    "patience": 0,
    "min_delta": 0.001,
    "scheduler_patience": 3,
    "scheduler_factor": 0.5,
    "min_lr": 1e-06,
    "log_every_steps": 20,
    "train_clean_eval": true,
    "class_weighting": "none",
    "weight_cap": 5.0,
    "sampling": "shuffle",
    "sampling_power": 1.0,
    "epoch_samples": null,
    "classification_weight": 1.0
  }
