{
  "data": {
    "source_path": "reference_nt.fasta",
    "cache_dir": "prepared",
    "seed": 42,
    "val_fraction": 0.1,
    "test_fraction": 0.1,
    "min_class_records": 3,
    "strip_species_suffix": true,
    "exclude_known_long_record": true
  },
  "bpe": {
    "vocab_size": 128,
    "min_frequency": 2
  },
  "model": {
    "d_model": 256,
    "nhead": 8,
    "num_layers": 2,
    "dim_feedforward": 1024,
    "dropout": 0.1,
    "max_length": 512
  },
  "training": {
    "max_epochs": 100,
    "batch_size": 16,
    "learning_rate": 0.0001,
